# ---- required
# Players type this to join. Pick something unguessable.
INVITE_CODE=pick-a-secret-phrase

# ---- AI Dungeon Master (optional; leave empty for the scripted DM)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ---- Cloudflare Tunnel (only for `docker compose --profile tunnel up -d`)
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Google sign-in through Cloudflare Access (see docs/DEPLOY.md → "Google sign-in")
# AUTH_MODE=access
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=the-application-audience-tag
# ADMIN_EMAILS=you@gmail.com           # always campaign owner; auto-links to the existing owner account
# ALLOW_INVITE_LOGIN=false             # true = also allow invite-code login (e.g. LAN while Cloudflare is down)

# ---- Manage the Cloudflare guest list from the game's Admin page (optional)
# API token with permission: Account → Access: Apps and Policies → Edit
# CF_API_TOKEN=
# CF_ACCOUNT_ID=                       # dashboard → any domain → Overview → "Account ID"
# CF_ACCESS_POLICY_ID=                 # optional; otherwise the app's Allow policy is found automatically

# ---- optional
# HOST_PORT=3000
# BIND_ADDR=0.0.0.0        # set 127.0.0.1 to hide the port from your LAN when using the tunnel
# BACKUP_HOURS=24          # automatic database backups into ./data/backups (0 = off)
# BACKUP_KEEP=14
# TZ=America/Chicago
