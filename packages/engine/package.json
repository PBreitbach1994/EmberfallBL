{
  "name": "@tavern/engine",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/campaign/content/index.d.ts",
      "default": "./dist/campaign/content/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/*.test.js",
    "sim": "tsc -p . && node dist/sim.js",
    "calibrate": "tsc -p . && node dist/sim.js calibrate 40 src/campaign/content/balance.ts"
  }
}